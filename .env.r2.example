# Copy to `.env.r2` and fill in. `.env.r2` is gitignored; this file is not, so
# it must never contain a real value.
#
# Read ONLY by scripts/r2/env.mjs, and never from process.env -- so an ambient
# wrangler login for another Cloudflare account cannot be picked up by accident.
#
# IMPORTANT: the parser takes everything after the first `=` as the value and
# does NOT strip trailing comments. Keep comments on their own lines, or
# `R2_BUCKET=my-bucket  # the bucket` becomes a bucket named
# "my-bucket  # the bucket" and every call 404s.

# Cloudflare account ID: 32 hex characters, on the right of the R2 overview page.
R2_ACCOUNT_ID=

# From an R2 API token scoped to "Object Read & Write" on this bucket only.
# A broader token is not needed: r2-setup.mjs expects to be refused on bucket
# configuration and prints what to paste into the dashboard instead.
R2_ACCESS_KEY_ID=

# Shown once, at token creation. Mint a new token if it was not saved.
R2_SECRET_ACCESS_KEY=

# Must match "bucket" in r2/manifest.json, or the scripts refuse to run rather
# than write into whatever bucket the credential happens to reach.
R2_BUCKET=

# Optional. Defaults to <R2_ACCOUNT_ID>.r2.cloudflarestorage.com, which is
# correct for every normal setup. Leave it unset unless you know otherwise.
# R2_ENDPOINT=
