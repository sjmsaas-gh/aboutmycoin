---
/**
 * The holding page: a white document with nothing on it.
 *
 * Used only while HOME_PLACEHOLDER is true in lib/site.ts -- which is to say,
 * in every build but not in `npm run dev`. That file is where the
 * reasoning and the reversal steps live. Deliberately NOT built on Base.astro:
 * the point is that a visitor to the domain gets no header, no footer, no
 * navigation into a half-finished site, no stylesheet and no analytics. Reusing
 * Base would drag all of that back in one import at a time.
 *
 * What it does carry, and why:
 *
 *   Seo.astro      title, description, canonical, and -- because DISCOVERABLE
 *                  is false -- the same `noindex` meta every other page gets.
 *                  Using the real component rather than hand-written tags means
 *                  the lockdown cannot be switched off here by accident.
 *   One JSON-LD    `tests/build-smoke.test.mjs` requires structured data on
 *                  every built page. Minimal WebSite only: the full
 *                  Organization graph describes a site that is not open yet.
 *
 * The white is forced with an inline style rather than left to the browser
 * default, because a browser in dark mode renders an unstyled document dark
 * grey. `color-scheme: only light` stops it inverting anything else.
 */
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, PLACEHOLDER_COPY } from '../lib/site';
---
<!doctype html>
<html lang="en" class="holding">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    {/* imageAlt is overridden so the share card does not narrate a tagline for
        a site that is not open. Everything else Seo emits is wanted. */}
    <Seo
      title={PLACEHOLDER_COPY.title}
      description={PLACEHOLDER_COPY.description}
      path="/"
      imageAlt={SITE.name}
    />
    <JsonLd
      schema={{
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${SITE.url}/#website`,
        name: SITE.name,
        url: SITE.url,
        inLanguage: 'en-US',
      }}
    />
    {/*
      `.holding` rather than a bare `html, body` selector, and `color-scheme`
      set in CSS rather than left to the meta tag above, because both have to
      beat global.css -- which this page still links, whether or not it wants
      to: index.astro imports Base.astro for the real home page, and Astro
      attributes that stylesheet to the route regardless of which branch runs.
      global.css sets `body { background-color: var(--bg) }` and `:root {
      color-scheme: light dark }`, so without the extra specificity here a
      visitor in dark mode gets a blank NEAR-BLACK page.
    */}
    <style is:inline>
      html.holding, html.holding body {
        background: #fff;
        color-scheme: light;
        margin: 0;
        padding: 0;
        height: 100%;
      }
    </style>
  </head>
  <body></body>
</html>
