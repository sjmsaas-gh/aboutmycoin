---
import { SITE, DISCOVERABLE, NOINDEX_DIRECTIVE } from '../lib/site';
import { renderedTitle } from '../lib/meta';

export interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/pricing". The canonical URL is built from it. */
  path?: string;
  /*
   * Where this page's canonical points, when that is NOT the page itself.
   * One use today: a grade page canonicalises to its coin. A grade is a
   * facet of one coin -- twenty-odd rungs of one ladder, sharing the coin's
   * specifications, its mintage and its metal floor -- so the coin page is
   * the page that should rank for the coin, and the rungs are there for the
   * reader who has been told a grade and arrives with it in hand. Anything
   * setting this must be reachable some other way, because a canonicalised
   * page is not one a crawler will index.
   */
  canonicalPath?: string;
  /** Absolute or site-relative OG image. Defaults to the site card. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /*
   * No `article:published_time` and no `article:modified_time`, deliberately.
   * Nothing this site states about a coin changes with the calendar, so a
   * modified date says only when a file was last saved -- and a crawler that
   * is told a page changed when it did not stops believing the ones that did.
   * The spot price is the single figure here with a shelf life, and it prints
   * its own date next to itself. See src/lib/spot.ts.
   */
  noindex?: boolean;
}

/** The site card: 1200x630, and the only share image any page uses today. */
const DEFAULT_IMAGE = '/og/default.png';

const {
  title,
  description,
  path = Astro.url.pathname,
  canonicalPath = path,
  image = DEFAULT_IMAGE,
  // What the card actually shows, which is a Morgan dollar over the name and
  // the tagline -- the strings here and the ones in
  // scripts/generate-brand-assets.mjs come from the same two SITE fields, so
  // they cannot drift. The site name alone would repeat og:site_name, and this
  // is what a screen reader announces for the card in a chat app.
  imageAlt = `${SITE.name}: ${SITE.tagline}. A silver Morgan dollar.`,
  type = 'website',
  noindex = false,
} = Astro.props;

const normalized = canonicalPath === '/' ? '/' : canonicalPath.replace(/\/+$/, '');
const canonical = new URL(normalized, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
// The suffix rule lives in src/lib/meta.ts, because the length checks have to
// measure the string this produces rather than the one a page declared.
const fullTitle = renderedTitle(title);

// The site-wide pre-launch lockdown overrides the per-page setting, and does so
// in one place so no page can opt itself back in by accident. See lib/site.ts.
const robots = !DISCOVERABLE || noindex
  ? NOINDEX_DIRECTIVE
  : 'index, follow, max-image-preview:large, max-snippet:-1';
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{/* Dimensions let a platform lay out the preview before it has fetched the
    image. Only stated for the card whose size is known; a page passing its
    own image would need to pass its size too. */}
{image === DEFAULT_IMAGE && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
  </>
)}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={SITE.locale} />

<meta name="twitter:card" content="summary_large_image" />
{/* Only when the handle genuinely exists -- see SITE.twitter. */}
{SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
