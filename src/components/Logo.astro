---
/**
 * The brand mark: the 1884 Morgan dollar, cut out of the hero photograph.
 *
 * A photograph rather than a glyph because the mark's only job at 20px is to
 * say "coins" before the wordmark next to it is read. The same coin appears in
 * the hero on the home page, in the favicon, in the OG card and in the
 * Organization logo -- one coin, seen everywhere, which is the whole of the
 * brand. All five come out of scripts/generate-brand-assets.mjs; do not crop a
 * new one by hand.
 *
 * Imported from src/assets/ rather than referenced from public/ so Astro emits
 * the exact rendered sizes (and a 2x for retina), gives the file a hashed
 * immutable URL, and writes width and height into the tag -- the header is
 * above every page on the site, so a mark that arrives late and shoves the
 * masthead sideways would spend the CLS budget of the whole site.
 */
import { Image } from 'astro:assets';
import mark from '../assets/morgan-mark.png';
interface Props {
  /** Rendered size in px. */
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
---
{/*
  alt is empty and aria-hidden set: every place this renders, the site's name
  is the text immediately beside it inside the same link. A screen reader that
  announced "AboutMyCoin, image, Morgan silver dollar, AboutMyCoin" would be
  reading the brand twice.

  Eager, not lazy: it is in the masthead, so it is in the viewport on every
  page, and `loading="lazy"` on an in-viewport image only delays it.
*/}
<Image
  src={mark}
  alt=""
  aria-hidden="true"
  width={size}
  height={size}
  densities={[2]}
  loading="eager"
  decoding="async"
  class:list={['shrink-0 rounded-full', cls]}
/>
