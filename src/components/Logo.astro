---
/**
 * The brand mark.
 *
 * Geometry is identical to public/favicon.svg and to the rasters produced by
 * scripts/generate-brand-assets.mjs -- if you change the path data here, change
 * it in both of those and re-run `npm run assets`.
 *
 * Inlined rather than loaded as an <img> so it inherits the accent colour in
 * dark mode and costs no request on the critical path.
 *
 * RENAME: this placeholder mark is deliberately plain. Replace the <g> contents
 * with the real mark, in a 32-unit viewBox, using the two CSS variables so it
 * keeps working in both themes.
 */
import { SITE } from '../lib/site';
interface Props {
  /** Rendered size in px. The 32-unit viewBox scales to it. */
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  role="img"
  aria-label={SITE.name}
  class:list={['shrink-0', cls]}
>
  <rect width="32" height="32" rx="7" fill="var(--accent)" />
  <path
    d="M16 7.5A8.5 8.5 0 1 1 9.99 9.99"
    fill="none"
    stroke="var(--accent-contrast)"
    stroke-width="3"
    stroke-linecap="round"
  />
  <circle cx="16" cy="16" r="3" fill="var(--accent-contrast)" />
</svg>
