---
/**
 * One generated landing page per entry in src/data/answers.ts.
 *
 * This is the programmatic-SEO pattern, and the reason it is worth copying is
 * that nothing on the page is typed twice: the H1, the opening answer, the
 * FAQPage `acceptedAnswer`, the Article `dateModified`, the breadcrumb trail
 * and the sitemap `lastmod` all come from the same object. They cannot drift,
 * because there is only one of them.
 *
 * A section with `steps` renders them as a numbered list AND becomes the
 * page's HowTo schema, from the same array. Only the first such section is
 * used for HowTo: a page is one procedure or none.
 */
import Base from '../../layouts/Base.astro';
import { ANSWERS, answerBySlug, type Answer } from '../../data/answers';
import { articleSchema, faqSchema, howToSchema } from '../../lib/schema';

export function getStaticPaths() {
  return ANSWERS.map((a) => ({ params: { slug: a.slug }, props: { answer: a } }));
}

export interface Props { answer: Answer }
const { answer } = Astro.props;
const path = `/answers/${answer.slug}`;
const related = (answer.related ?? []).map(answerBySlug).filter(Boolean) as Answer[];
const procedure = answer.sections.find((s) => s.steps && s.steps.length > 0);
---
<Base
  title={answer.seoTitle ?? answer.question}
  description={answer.description}
  path={path}
  type="article"
  publishedTime={answer.published}
  modifiedTime={answer.updated}
  crumbs={[
    { label: 'Answers', href: '/answers' },
    { label: answer.question, href: path },
  ]}
  schemas={[
    articleSchema({
      headline: answer.question,
      description: answer.description,
      path,
      datePublished: answer.published,
      dateModified: answer.updated,
    }),
    // The page's own question and its BLUF answer, as a one-item FAQPage. This
    // is what makes the opening sentence eligible to be quoted directly.
    faqSchema([{ q: answer.question, a: answer.answer }]),
    ...(procedure?.steps
      ? [howToSchema({ name: answer.question, description: answer.answer, steps: procedure.steps })]
      : []),
  ]}
>
  <article class="container-page pt-12 pb-20">
    <div class="prose-page">
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.75rem">{answer.question}</h1>

      <!-- BLUF. The complete answer, before anything else on the page, in the
           same words the schema carries. Someone who reads only this has been
           served; a model that quotes only this has quoted something true. -->
      <p class="text-lg"><strong>{answer.answer}</strong></p>

      {answer.sections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.steps && (
            <ol>
              {s.steps.map((st) => (
                <li><strong>{st.name}.</strong> {st.text}</li>
              ))}
            </ol>
          )}
        </section>
      ))}

      {related.length > 0 && (
        <section>
          <h2>Related</h2>
          <ul>
            {related.map((r) => (
              <li><a href={`/answers/${r.slug}`}>{r.question}</a></li>
            ))}
          </ul>
        </section>
      )}

      <p class="text-sm" style="color: var(--text-muted)">
        Last updated {answer.updated}.
      </p>
    </div>
  </article>
</Base>
