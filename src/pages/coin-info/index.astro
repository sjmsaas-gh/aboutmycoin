---
/**
 * The catalogue root: /coin-info.
 *
 * Its job is to make one decision easy -- what is your coin made of -- because
 * that is the question whose answer changes the value most, and it is one a
 * person can answer by looking at the coin rather than by knowing anything.
 *
 * Only populated groups are listed, and the listing, the ItemList schema and
 * the sitemap all read the same filter. An empty archive would be thin content
 * with a breadcrumb on it.
 */
import Base from '../../layouts/Base.astro';
import TileCard from '../../components/TileCard.astro';
import { itemListSchema, webPageSchema, faqSchema } from '../../lib/schema';
import {
  populatedGroups,
  populatedTags,
  groupPath,
  tagPath,
} from '../../data/coins';
import {
  HUB_ANSWER,
  HUB_DESCRIPTION,
  HUB_H1,
  HUB_INTRO,
  HUB_QUESTION,
  HUB_SEO_TITLE,
  groupH1,
} from '../../lib/catalog-copy';
import { CARDS_PER_SECTION, groupArtKey, tagArtKey } from '../../lib/card-art';
import { SECTION_BLURB } from '../../lib/section-copy';

const groups = populatedGroups().slice(0, CARDS_PER_SECTION);
const tags = populatedTags();
// Three separate questions, so three separate sections. A visitor looking for
// "Mercury dime" and one looking for "Canadian coins" are not browsing the
// same list, and the leftovers are trade categories rather than either.
//
// Each list is capped at CARDS_PER_SECTION. A hub is a set of choices and a
// grid that runs past the fold is a list instead; the tag archive at
// /coin-info/tagged is where every tag is reachable, and the topic section
// links to it. The order the slice takes is the registry's, which is not yet
// the order these should be offered in.
const seriesTags = tags.filter((t) => t.kind === 'series').slice(0, CARDS_PER_SECTION);
const countryTags = tags.filter((t) => t.kind === 'country').slice(0, CARDS_PER_SECTION);
const otherTags = tags
  .filter((t) => t.kind !== 'series' && t.kind !== 'country')
  .slice(0, CARDS_PER_SECTION);
const path = '/coin-info';

// Every string on this page that also appears in its schema, its <title> or
// its FAQ answer comes from catalog-copy.ts, which is the module the whole
// section's copy lives in. The hub's own sections are hand-written -- it is one
// page, and the generator exists for the hundreds below it.
const H1 = HUB_H1;
const BLUF = HUB_ANSWER;
const DESCRIPTION = HUB_DESCRIPTION;

const question = HUB_QUESTION;
---
<Base
  title={HUB_SEO_TITLE}
  description={DESCRIPTION}
  path={path}
  crumbs={[{ label: 'Coin info', href: path }]}
  schemas={[
    webPageSchema({
      type: 'CollectionPage',
      name: H1,
      description: DESCRIPTION,
      path,
    }),
    itemListSchema({
      name: 'Coins by metal',
      description: DESCRIPTION,
      items: groups.map((g) => ({ name: groupH1(g), path: groupPath(g.slug) })),
    }),
    faqSchema([{ q: question, a: BLUF }]),
    /*
     * NO Dataset HERE, and that is the rule in schema.ts applied rather than
     * relaxed: `variableMeasured` must list columns the page genuinely
     * renders.
     *
     * This hub declared eight of them -- composition, weight, diameter, silver
     * and gold content, face value, mintage, scarcity -- and renders none of
     * them: it is nine cards. They were real when the hub listed every coin on
     * the site. The cards rewrite took the list out ("There is no 'all coins'
     * section"), and the schema stayed behind describing a page that no longer
     * exists.
     * The comment over it even said so: "every column listed here is a column
     * the pages BELOW genuinely render", which is an admission that the claim
     * was about other URLs.
     *
     * CollectionPage over an ItemList is what a hub of cards is, and it is
     * already above. The Dataset facts are still asserted where they are shown
     * -- on the group archives, on the calculators and on every coin page's
     * Product node.
     */
  ]}
>
  <section class="container-page pt-8 pb-10">
    <div class="prose-page">
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.85rem">{H1}</h1>
      <div class="reeded" aria-hidden="true" style="--metal: var(--metal-silver)"></div>
      <div class="verdict" style="--metal: var(--metal-silver)">
        <span class="verdict-label">{question}</span>
        <p>{BLUF}</p>
      </div>
      {HUB_INTRO.map((p) => <p style="margin-top: 1.3rem">{p}</p>)}
      {/*
        The link across to the mirror section, which every page on this side
        of the site owes its twin -- tests/build-smoke.test.mjs fails on a
        missing one in either direction. It is a sentence rather than a
        navigation link because the metal is half of what the paragraph above
        just said a coin is worth, and the anchor text is the phrase the page
        it points at wants to rank for.
      */}
      <p>
        What that metal is worth on its own is worked out coin by coin under
        {' '}<a href="/melt-value">melt values</a>.
      </p>
    </div>
  </section>

  {groups.length === 0 ? (
    /* The catalogue is empty and the page says so. An archive that renders a
       blank grid and a confident heading is worse than one that admits it has
       nothing yet -- and while DISCOVERABLE is false nobody but us sees this
       anyway. Every section below reappears on its own the moment the first
       coin lands in the registry. */
    <section class="container-page pb-20">
      <div class="prose-page">
        <h2 style="margin-top: 0">The catalogue is still being built</h2>
        <p>
          There are no coins in it yet. The structure is finished and the
          addresses are settled, so nothing below will move once entries start
          arriving:
        </p>
        <ul>
          <li>
            Each coin lives at <code>/coin-info/&lt;metal&gt;/&lt;denomination&gt;/&lt;coin&gt;</code>
            — for example <code>/coin-info/silver/quarter/1964-washington-quarter</code>.
          </li>
          <li>
            Its metal and its denomination are in the address because neither
            can ever be revised. Everything else about a coin — its country,
            its series, whether it counts as a key date — is a tag, because
            those are the things we may reclassify.
          </li>
          <li>
            Archive pages for a metal, for a denomination and for each tag are
            generated from the coins themselves, so none of them can list a
            page that does not exist or omit one that does.
          </li>
        </ul>
      </div>
    </section>
  ) : (
    <>
      <section class="container-page pb-12">
        <div class="prose-page" style="margin-bottom: 1.1rem">
          <h2 style="margin-top: 0">By metal type</h2>
          <p>{SECTION_BLURB.metal}</p>
        </div>
        <div class="tile-grid">
          {groups.map((g) => (
            <TileCard
              href={groupPath(g.slug)}
              label={g.name}
              metal={g.slug}
              artKey={groupArtKey(g.slug)}
            />
          ))}
        </div>
      </section>

      {seriesTags.length > 0 && (
        <section id="by-series" class="container-page pb-12">
          <div class="prose-page" style="margin-bottom: 1.1rem">
            <h2 style="margin-top: 0">By series</h2>
            <p>{SECTION_BLURB.series}</p>
          </div>
          <div class="tile-grid">
            {seriesTags.map((t) => (
              <TileCard href={tagPath(t.slug)} label={t.name} artKey={tagArtKey(t.slug)} />
            ))}
          </div>
        </section>
      )}

      {countryTags.length > 0 && (
        <section id="by-country" class="container-page pb-12">
          <div class="prose-page" style="margin-bottom: 1.1rem">
            <h2 style="margin-top: 0">By country</h2>
            <p>{SECTION_BLURB.country}</p>
          </div>
          <div class="tile-grid">
            {countryTags.map((t) => (
              <TileCard href={tagPath(t.slug)} label={t.name} artKey={tagArtKey(t.slug)} />
            ))}
          </div>
        </section>
      )}

      {otherTags.length > 0 && (
        <section id="by-topic" class="container-page pb-20">
          <div class="prose-page" style="margin-bottom: 1.1rem">
            <h2 style="margin-top: 0">By topic</h2>
            <p>
              {SECTION_BLURB.topic}{' '}<a href="/coin-info/tagged">All topics</a>.
            </p>
          </div>
          <div class="tile-grid">
            {otherTags.map((t) => (
              <TileCard href={tagPath(t.slug)} label={t.name} artKey={tagArtKey(t.slug)} />
            ))}
          </div>
        </section>
      )}
    </>
  )}
</Base>
