---
/**
 * The tag index: /coin-info/tagged.
 *
 * Exists so that the reserved `tagged` segment is a real page rather than a
 * 404 a visitor reaches by deleting the last part of a URL, which is a thing
 * people genuinely do. It is also where the two axes of the structure get
 * explained to a human in one place.
 *
 * Grouped by kind, because "series", "country" and "topic" are different
 * questions and a flat alphabetical list of thirty pills answers none of them.
 */
import Base from '../../../layouts/Base.astro';
import TileCard from '../../../components/TileCard.astro';
import { itemListSchema, webPageSchema } from '../../../lib/schema';
import { populatedTags, tagPath } from '../../../data/coins';
import {
  TAGGED_DESCRIPTION,
  TAGGED_H1,
  TAGGED_SEO_TITLE,
  TAG_KIND_SECTIONS,
} from '../../../lib/catalog-copy';
import { tagArtKey } from '../../../lib/card-art';

const path = '/coin-info/tagged';
const tags = populatedTags();

// The sections, their headings and their blurbs all live in catalog-copy.ts
// with the rest of the section's copy; this page decides which of them have a
// populated tag to show.
const sections = TAG_KIND_SECTIONS.map((o) => ({
  ...o,
  tags: tags.filter((t) => t.kind === o.kind),
})).filter((s) => s.tags.length > 0);
const DESCRIPTION = TAGGED_DESCRIPTION;
---
<Base
  title={TAGGED_SEO_TITLE}
  description={DESCRIPTION}
  path={path}
  crumbs={[
    { label: 'Coin info', href: '/coin-info' },
    { label: 'Topics', href: path },
  ]}
  schemas={[
    webPageSchema({
      type: 'CollectionPage',
      name: TAGGED_H1,
      description: DESCRIPTION,
      path,
    }),
    itemListSchema({
      name: TAGGED_H1,
      description: DESCRIPTION,
      items: tags.map((t) => ({ name: t.name, path: tagPath(t.slug) })),
    }),
  ]}
>
  <section class="container-page pt-8 pb-10">
    <div class="prose-page">
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.85rem">{TAGGED_H1}</h1>
      <div class="reeded" aria-hidden="true" style="--metal: var(--accent)"></div>
      <p class="text-lg">
        <strong>
          Find your coin by its series, the country that struck it, the alloy
          it is made of or the category the trade files it under.
        </strong>
      </p>
      <p>
        The same labels cut across <a href="/melt-value/tagged">the melt
        tables</a>, where each one adds up what the metal in it comes to
        rather than what the coins are worth.
      </p>
    </div>
  </section>

  {sections.length === 0 ? (
    <section class="container-page pb-20">
      <div class="prose-page">
        <h2 style="margin-top: 0">No topics yet</h2>
        <p>
          A topic page appears here as soon as a coin is tagged with it. The
          tags themselves are already written — series, countries, compositions
          and the categories the trade uses — and each one is held back until it
          has something to list, because a topic page with nothing on it is a
          heading and an empty grid.
        </p>
        <p><a href="/coin-info">Back to the catalogue</a>.</p>
      </div>
    </section>
  ) : sections.map((s) => (
    <section class="container-page pb-12">
      <div class="prose-page" style="margin-bottom: 1rem">
        <h2 style="margin-top: 0">{s.title}</h2>
        <p>{s.blurb}</p>
      </div>
      <div class="tile-grid">
        {s.tags.map((t) => (
          <TileCard href={tagPath(t.slug)} label={t.name} artKey={tagArtKey(t.slug)} />
        ))}
      </div>
    </section>
  ))}
  <div class="pb-8"></div>
</Base>
