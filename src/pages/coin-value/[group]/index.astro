---
/**
 * A composition archive: /coin-value/<group>.
 *
 * Generated only for groups that have coins. A registered group with nothing
 * in it does not get a URL -- see `populatedGroups()` and the note on it.
 *
 * The page answers the group's own question in its first sentence and then
 * splits by denomination, because "I have a silver coin" and "I have a silver
 * quarter" are different amounts of knowledge and the second one deserves a
 * shorter path to the number.
 */
import Base from '../../../layouts/Base.astro';
import CoinTile from '../../../components/CoinTile.astro';
import { itemListSchema, webPageSchema, faqSchema } from '../../../lib/schema';
import {
  populatedGroups,
  populatedTypes,
  coinsInGroup,
  coinsInGroupType,
  groupPath,
  typePath,
  tagPath,
  latestUpdated,
  pairQuestion,
  TAGS,
  type Group,
} from '../../../data/coins';

export function getStaticPaths() {
  return populatedGroups().map((group) => ({ params: { group: group.slug }, props: { group } }));
}

export interface Props { group: Group }
const { group } = Astro.props;

const path = groupPath(group.slug);
const coins = coinsInGroup(group.slug);
const types = populatedTypes(group.slug);
const updated = latestUpdated(coins, group.updated);

// Tags reachable from this group, so a silver page offers "junk silver" and
// "Canada" rather than the whole tag list. Built from the coins present, so it
// cannot advertise a tag page this group has nothing on.
const tagSlugs = new Set(coins.flatMap((c) => c.tags));
const tags = TAGS.filter((t) => tagSlugs.has(t.slug));
---
<Base
  title={group.seoTitle}
  description={group.description}
  path={path}
  crumbs={[
    { label: 'Coin values', href: '/coin-value' },
    { label: group.name, href: path },
  ]}
  schemas={[
    webPageSchema({
      type: 'CollectionPage',
      name: group.h1,
      description: group.description,
      path,
      dateModified: updated,
    }),
    itemListSchema({
      name: group.h1,
      description: group.description,
      items: types.map((t) => ({
        name: `${group.name} ${t.namePlural.toLowerCase()}`,
        path: typePath(group.slug, t.slug),
      })),
    }),
    faqSchema([{ q: group.faqQuestion, a: group.bluf }]),
  ]}
>
  <section class="container-page pt-8 pb-10">
    <div class="prose-page">
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.9rem">{group.h1}</h1>
      <div class="verdict" style={`--metal: var(--metal-${group.slug})`}>
        <span class="verdict-label">{group.faqQuestion}</span>
        <p>{group.bluf}</p>
      </div>
      {group.intro.map((p) => <p style="margin-top: 1.3rem">{p}</p>)}
      {group.meltDriven && (
        <p class="mathline">
          <strong>The arithmetic:</strong> metal value = actual metal weight in
          troy ounces &times; the current spot price per troy ounce. Every coin
          below states its own metal weight, so the only thing you need to look
          up is the spot price.
        </p>
      )}
    </div>
  </section>

  <section class="container-page pb-12">
    <div class="prose-page" style="margin-bottom: 1.1rem">
      <h2 style="margin-top: 0">{group.name} coins by denomination</h2>
      <p>
        Pick the denomination you are holding. Each one answers the same
        question for that coin specifically, with the metal weight already
        worked out.
      </p>
    </div>
    <div class="tile-grid">
      {types.map((t) => {
        const n = coinsInGroupType(group.slug, t.slug).length;
        return (
          <a href={typePath(group.slug, t.slug)} class="tile" style={`--metal: var(--metal-${group.slug})`}>
            <h3><span class="metal-dot" aria-hidden="true"></span>{group.name} {t.namePlural.toLowerCase()}</h3>
            <p>{pairQuestion(group, t)} {t.bluf}</p>
            <p class="tile-meta">{n} {n === 1 ? 'entry' : 'entries'}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container-page pb-12">
    <div class="prose-page" style="margin-bottom: 1.1rem">
      <h2 style="margin-top: 0">Every {group.name.toLowerCase()} coin in the catalogue</h2>
    </div>
    <div class="tile-grid">
      {coins.map((c) => <CoinTile coin={c} />)}
    </div>
  </section>

  {tags.length > 0 && (
    <section class="container-page pb-20">
      <div class="prose-page" style="margin-bottom: 1.1rem">
        <h2 style="margin-top: 0">Related series, countries and topics</h2>
      </div>
      <div class="pill-row">
        {tags.map((t) => <a href={tagPath(t.slug)} class="pill">{t.name}</a>)}
      </div>
    </section>
  )}
</Base>
