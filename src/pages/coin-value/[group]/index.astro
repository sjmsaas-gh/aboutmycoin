---
/**
 * A composition archive: /coin-value/<group>.
 *
 * Generated only for groups that have coins. A registered group with nothing
 * in it does not get a URL -- see `populatedGroups()` and the note on it.
 *
 * The page answers the group's own question in its first sentence and then
 * splits by denomination, because "I have a silver coin" and "I have a silver
 * quarter" are different amounts of knowledge and the second one deserves a
 * shorter path to the number.
 *
 * Every string on the page comes from `src/lib/catalog-copy.ts`, which
 * generates it from the group and the coins in it and hands back whatever the
 * registry writes by hand instead. Nothing here decides any wording of its own:
 * this template is a layout, and the copy it lays out is checked at build time.
 */
import Base from '../../../layouts/Base.astro';
import CoinTile from '../../../components/CoinTile.astro';
import { itemListSchema, webPageSchema, faqSchema } from '../../../lib/schema';
import { meltGroups, meltGroupPath } from '../../../lib/melt';
import {
  groupAnswer,
  groupDescription,
  groupH1,
  groupIntro,
  groupNotes,
  groupQuestion,
  groupSections,
  groupSeoTitle,
  pairStat,
  pairTeaser,
  tagsInGroup,
} from '../../../lib/catalog-copy';
import {
  populatedGroups,
  populatedTypes,
  coinsInGroup,
  groupPath,
  typePath,
  tagPath,
  type Group,
} from '../../../data/coins';

export function getStaticPaths() {
  return populatedGroups().map((group) => ({ params: { group: group.slug }, props: { group } }));
}

export interface Props { group: Group }
const { group } = Astro.props;

const path = groupPath(group.slug);
const coins = coinsInGroup(group.slug);
const types = populatedTypes(group.slug);

const h1 = groupH1(group);
const description = groupDescription(group);
const question = groupQuestion(group);
const answer = groupAnswer(group);
const intro = groupIntro(group);
// Hand-written paragraphs, after the generated ones rather than instead of
// them: the counts and the year span stay, the specifics are added.
const notes = groupNotes(group);
const sections = groupSections(group);

// Tags reachable from this group, so a silver page offers "junk silver" and
// "Canada" rather than the whole tag list. Built from the coins present, so it
// cannot advertise a tag page this group has nothing on -- or one that is
// registered and unpopulated, which has no page at all.
const tags = tagsInGroup(group);

// The melt twin, when it is built. See the note on the tag page: the archive
// exists for every populated group while MELT_PAGE_FOR_EVERY_COIN is true,
// and a hard-coded href would be a 404 the day it is not.
const meltTwin = meltGroups().some((g) => g.slug === group.slug)
  ? meltGroupPath(group.slug)
  : undefined;
---
<Base
  title={groupSeoTitle(group)}
  description={description}
  path={path}
  crumbs={[
    { label: 'Coin values', href: '/coin-value' },
    { label: group.name, href: path },
  ]}
  schemas={[
    webPageSchema({
      type: 'CollectionPage',
      name: h1,
      description: description,
      path,
    }),
    itemListSchema({
      name: h1,
      description: description,
      items: types.map((t) => ({
        name: `${group.name} ${t.namePlural.toLowerCase()}`,
        path: typePath(group.slug, t.slug),
      })),
    }),
    faqSchema([{ q: question, a: answer }]),
  ]}
>
  <section class="container-page pt-8 pb-10">
    <div class="prose-page">
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.85rem">{h1}</h1>
      <div class="reeded" aria-hidden="true" style={`--metal: var(--metal-${group.slug})`}></div>
      <div class="verdict" style={`--metal: var(--metal-${group.slug})`}>
        <span class="verdict-label">{question}</span>
        <p>{answer}</p>
      </div>
      {intro.map((p) => <p style="margin-top: 1.3rem">{p}</p>)}
      {notes.map((p) => <p style="margin-top: 1.3rem">{p}</p>)}
      {group.meltDriven && (
        <p class="mathline">
          <strong>The arithmetic:</strong> metal value = actual metal weight in
          troy ounces &times; the current spot price per troy ounce. Every coin
          below states its own metal weight, so the only thing you need to look
          up is the spot price.
        </p>
      )}
      {meltTwin && (
        <p>
          The same coins with the arithmetic already done, and nothing else on
          the page, are at
          {' '}<a href={meltTwin}>{group.name.toLowerCase()} melt values</a>.
        </p>
      )}
    </div>
  </section>

  <section class="container-page pb-12">
    <div class="prose-page" style="margin-bottom: 1.1rem">
      <h2 style="margin-top: 0">{sections.denominations.heading}</h2>
      <p>{sections.denominations.intro}</p>
    </div>
    <div class="tile-grid">
      {types.map((t) => {
        return (
          <a href={typePath(group.slug, t.slug)} class="tile" style={`--metal: var(--metal-${group.slug})`}>
            <h3><span class="metal-dot" aria-hidden="true"></span>{group.name} {t.namePlural.toLowerCase()}</h3>
            <p>{pairTeaser(group, t)}</p>
            <p class="tile-meta">{pairStat(group, t)}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="container-page pb-12">
    <div class="prose-page" style="margin-bottom: 1.1rem">
      <h2 style="margin-top: 0">{sections.coins.heading}</h2>
    </div>
    <div class="tile-grid">
      {coins.map((c) => <CoinTile coin={c} />)}
    </div>
  </section>

  {tags.length > 0 && (
    <section class="container-page pb-20">
      <div class="prose-page" style="margin-bottom: 1.1rem">
        <h2 style="margin-top: 0">{sections.tags.heading}</h2>
      </div>
      <div class="pill-row">
        {tags.map((t) => <a href={tagPath(t.slug)} class="pill">{t.name}</a>)}
      </div>
    </section>
  )}
</Base>
