---
/**
 * One coin: /coin-value/<group>/<type>/<coin>.
 *
 * The page the whole site exists for, and the one with the most structured
 * data on it. Nothing here is typed twice -- the H1, the opening answer, the
 * FAQPage `acceptedAnswer`, the HowTo steps, the Product properties, the
 * Article `dateModified`, the breadcrumb trail and the sitemap `lastmod` are
 * all read off the same `Coin` object, so they cannot drift apart.
 *
 * Schema emitted, and why each one:
 *
 *   Article   the editorial content, with real dates.
 *   FAQPage   one question, the one this page owns. Uniqueness across the
 *             whole catalogue is enforced in coins.ts, because Google wants a
 *             question marked up on exactly one page.
 *   HowTo     the identification checklist. Every coin has one, so it is the
 *             consistent source; a section's own `steps` render as an ordered
 *             list but do not become a second HowTo, since Google will use one
 *             per page and two is a coin toss over which.
 *   Product   the coin as an object -- alloy, weight, diameter, metal content,
 *             country, production date. Deliberately without `offers`; see the
 *             note on coinProductSchema.
 *
 * The order of the visible page is fixed and is the argument of the site:
 * answer, then how to be sure it is that coin, then the arithmetic, then the
 * detail. Somebody who reads only the first box has been served.
 */
import Base from '../../../../layouts/Base.astro';
import { SITE } from '../../../../lib/site';
import CoinTile from '../../../../components/CoinTile.astro';
import {
  articleSchema,
  faqSchema,
  howToSchema,
  coinProductSchema,
} from '../../../../lib/schema';
import {
  COINS,
  coinBySlug,
  coinPath,
  groupPath,
  typePath,
  tagPath,
  groupBySlug,
  typeBySlug,
  tagBySlug,
  yearLabel,
  coinQuestion,
  COMMONALITY_NOTE,
  type Coin,
} from '../../../../data/coins';

export function getStaticPaths() {
  return COINS.map((coin) => ({
    params: { group: coin.group, type: coin.type, coin: coin.slug },
    props: { coin },
  }));
}

export interface Props { coin: Coin }
const { coin } = Astro.props;

// Non-null: validateTaxonomy() throws at build time on an unknown group, type
// or tag, so by the time this renders every lookup has resolved.
const group = groupBySlug(coin.group)!;
const type = typeBySlug(coin.type)!;
const tags = coin.tags.map(tagBySlug).filter(Boolean) as NonNullable<ReturnType<typeof tagBySlug>>[];
const related = (coin.related ?? []).map(coinBySlug).filter(Boolean) as Coin[];

const path = coinPath(coin);
const question = coinQuestion(coin);
const years = yearLabel(coin);

const metal = coin.silverOzt
  ? { metal: 'Silver' as const, troyOunces: coin.silverOzt }
  : coin.goldOzt
    ? { metal: 'Gold' as const, troyOunces: coin.goldOzt }
    : undefined;

const badge =
  coin.commonality === 'key-date'
    ? 'badge-key'
    : coin.commonality === 'scarce'
      ? 'badge-scarce'
      : 'badge-common';
const badgeLabel = {
  'very-common': 'Very common',
  common: 'Common',
  scarce: 'Scarce',
  'key-date': 'Key date',
}[coin.commonality];

/** The spec table, built once so the visible rows and the Product properties agree. */
const specs: { label: string; value: string }[] = [
  { label: 'Years', value: years },
  { label: 'Country', value: coin.country },
  { label: 'Denomination', value: type.name },
  { label: 'Face value', value: coin.faceValue },
  { label: 'Composition', value: coin.composition },
  ...(coin.mintMark ? [{ label: 'Mint mark', value: coin.mintMark }] : []),
  ...(coin.weightGrams ? [{ label: 'Weight', value: `${coin.weightGrams} g` }] : []),
  ...(coin.diameterMm ? [{ label: 'Diameter', value: `${coin.diameterMm} mm` }] : []),
  ...(coin.silverOzt ? [{ label: 'Silver content', value: `${coin.silverOzt} troy oz` }] : []),
  ...(coin.goldOzt ? [{ label: 'Gold content', value: `${coin.goldOzt} troy oz` }] : []),
  ...(coin.mintage ? [{ label: 'Mintage', value: coin.mintage.toLocaleString('en-US') }] : []),
];
---
<Base
  title={coin.seoTitle}
  description={coin.description}
  path={path}
  type="article"
  publishedTime={coin.published}
  modifiedTime={coin.updated}
  crumbs={[
    { label: 'Coin values', href: '/coin-value' },
    { label: group.name, href: groupPath(group.slug) },
    { label: type.namePlural, href: typePath(group.slug, type.slug) },
    { label: coin.shortName ?? coin.name, href: path },
  ]}
  schemas={[
    articleSchema({
      headline: coin.name,
      description: coin.description,
      path,
      datePublished: coin.published,
      dateModified: coin.updated,
    }),
    faqSchema([{ q: question, a: coin.bluf }]),
    howToSchema({
      name: `How to identify a ${coin.shortName ?? coin.name}`,
      description: `Confirm that the coin in your hand is a ${coin.shortName ?? coin.name} before valuing it.`,
      steps: coin.identify.map((text, i) => ({ name: `Check ${i + 1}`, text })),
      tool: ['A magnifier', 'A scale accurate to 0.1 grams'],
    }),
    coinProductSchema({
      name: coin.name,
      description: coin.description,
      path,
      material: coin.composition,
      country: coin.country,
      productionDate: coin.years.to ? `${coin.years.from}/${coin.years.to}` : String(coin.years.from),
      weightGrams: coin.weightGrams,
      diameterMm: coin.diameterMm,
      metalContent: metal,
      category: `${group.name} ${type.namePlural.toLowerCase()}`,
      dateModified: coin.updated,
    }),
  ]}
>
  <article class="container-page pt-8 pb-20" style={`--metal: var(--metal-${group.slug})`}>
    <div class="prose-page">
      <p class="tile-meta" style="margin: 0 0 0.4rem">
        <span class="metal-dot" aria-hidden="true"></span>
        {group.name} &middot; {type.name} &middot; {coin.country} &middot; {years}
      </p>
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.9rem">{coin.name}</h1>

      {/* BLUF. The complete answer, before anything else, in exactly the words
          the FAQPage schema carries. A model that quotes only this has quoted
          something true and self-contained. */}
      <div class="verdict">
        <span class="verdict-label">{question}</span>
        <p>{coin.bluf}</p>
      </div>

      <p style="margin-top: 1rem">
        <span class={`badge ${badge}`}>{badgeLabel}</span>
        <span style="margin-left: 0.6rem; color: var(--text-muted)">{COMMONALITY_NOTE[coin.commonality]}</span>
      </p>

      {metal && (
        <>
          <h2>The metal value, worked out</h2>
          <p class="mathline">
            <strong>{metal.troyOunces} troy oz</strong> of {metal.metal.toLowerCase()}
            &times; the current {metal.metal.toLowerCase()} spot price per troy ounce
            = the metal value of one {coin.shortName ?? coin.name}.
          </p>
          <p>
            That figure is the floor. A dealer buying will pay under it and a
            dealer selling will charge over it; the gap is the spread, and it
            narrows as the quantity rises. Anything above the floor is collector
            premium, and the sections below say when there is any.
          </p>
        </>
      )}

      <h2>How to be sure this is the coin you have</h2>
      <p>
        Work down the list. Each check is something you can do with the coin in
        front of you, and the order runs from the quickest to the most
        involved.
      </p>
      <ol class="checklist not-prose">
        {coin.identify.map((step) => <li><span>{step}</span></li>)}
      </ol>

      <h2>Specification</h2>
      <div class="card" style="padding: 1.15rem 1.35rem; margin-bottom: 1.4rem">
        <dl class="spec-grid">
          {specs.map((s) => (
            <>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </>
          ))}
        </dl>
      </div>

      {coin.sections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.steps && (
            <ol>
              {s.steps.map((st) => <li><strong>{st.name}.</strong> {st.text}</li>)}
            </ol>
          )}
        </section>
      ))}

      {coin.values && coin.values.length > 0 ? (
        <section>
          <h2>Value by grade</h2>
          <p>
            Ranges, not figures. Condition dominates coin value and we cannot
            see your coin, so a single number would be a promise this page
            cannot keep.
          </p>
          <div class="card table-scroll" style="padding: 0.4rem 0">
            <table style="width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums">
              <thead>
                <tr>
                  <th style="text-align: left; padding: 0.6rem 1rem">Grade</th>
                  <th style="text-align: right; padding: 0.6rem 1rem">Value range (USD)</th>
                </tr>
              </thead>
              <tbody>
                {coin.values.map((v) => (
                  <tr style="border-top: 1px solid var(--border)">
                    <td style="padding: 0.6rem 1rem">{v.grade}</td>
                    <td style="padding: 0.6rem 1rem; text-align: right">
                      ${v.low.toLocaleString('en-US')} &ndash; ${v.high.toLocaleString('en-US')}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="text-sm" style="color: var(--text-muted)">
            Observed {coin.valueAsOf}.
            {coin.sources && coin.sources.length > 0 && (
              <> Sources: {coin.sources.map((s) => (s.url ? <a href={s.url} rel="nofollow">{s.name}</a> : <span>{s.name}</span>))}.</>
            )}
          </p>
        </section>
      ) : (
        /* Fail honestly. The graded price table is not published because the
           market-data source has not been decided -- see SPEC.md. Saying so is
           better than printing a range nobody measured, and the page is still
           useful: the metal arithmetic above is exact. */
        <section>
          <h2>Graded price ranges are not published yet</h2>
          <p>
            This page does not carry a table of prices by grade, because
            {' '}{SITE.name} does not yet have a market-data source it is
            willing to stand behind. When it does, the table will state the
            grade each range assumes and where the figures came from, the same
            way the metal arithmetic above shows its working.
          </p>
          <p>
            Nothing else on this page depends on it. The composition, the metal
            content and the identification checks are published mint
            specifications, and the metal value is a calculation you can repeat.
          </p>
        </section>
      )}

      <section>
        <h2>What this page is not</h2>
        <p>
          It is not an appraisal. {SITE.name} estimates from published
          specifications and market data; it does not authenticate a coin, does
          not grade one, and cannot see the coin you are holding. For a coin
          worth enough to matter, a grading service is the next step, and it is
          worth the fee precisely because this page cannot substitute for it.
        </p>
      </section>

      {tags.length > 0 && (
        <section>
          <h2>Also filed under</h2>
          <div class="pill-row not-prose">
            {tags.map((t) => <a href={tagPath(t.slug)} class="pill">{t.name}</a>)}
          </div>
        </section>
      )}

      <p class="text-sm" style="color: var(--text-muted); margin-top: 2rem">
        Last updated {coin.updated}.
      </p>
    </div>

    {related.length > 0 && (
      <section style="margin-top: 2.5rem">
        <div class="prose-page" style="margin-bottom: 1.1rem">
          <h2 style="margin-top: 0">Related coins</h2>
        </div>
        <div class="tile-grid">
          {related.map((r) => <CoinTile coin={r} showGroup groupName={groupBySlug(r.group)?.name} />)}
        </div>
      </section>
    )}
  </article>
</Base>
