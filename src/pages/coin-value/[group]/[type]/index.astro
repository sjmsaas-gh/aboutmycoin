---
/**
 * A denomination archive within one composition: /coin-value/<group>/<type>.
 *
 * Generated only for (group, type) pairs that have at least one coin, which is
 * the anti-thin-content guard for the deepest archive level: the combinatorial
 * product of nine groups and eight denominations is seventy-two URLs, and only
 * the eight that hold something get built.
 *
 * Every string on the page is generated in `src/lib/catalog-copy.ts` from the
 * group, the denomination and the coins standing at the pair. There is
 * deliberately no registry of hand-written pair copy and no field to add one
 * to: this is the level with the most URLs behind it and the least to say that
 * its group and its denomination have not said already, and the day "silver
 * quarters" earns a real explanation, the explanation belongs on the coin pages
 * underneath it.
 */
import Base from '../../../../layouts/Base.astro';
import CoinTile from '../../../../components/CoinTile.astro';
import { itemListSchema, webPageSchema, faqSchema } from '../../../../lib/schema';
import { meltPairs, meltTypePath, metalsIn } from '../../../../lib/melt';
import { METAL_LABEL, formatUsd, spotPrice, spotCaveat } from '../../../../lib/spot';
import {
  pairAnswer,
  pairDescription,
  pairH1,
  pairIntro,
  pairSections,
  pairSeoTitle,
} from '../../../../lib/catalog-copy';
import {
  populatedPairs,
  coinsInGroupType,
  typePath,
  groupPath,
  coinPath,
  pairQuestion,
  type Group,
  type CoinType,
} from '../../../../data/coins';

export function getStaticPaths() {
  return populatedPairs().map(({ group, type }) => ({
    params: { group: group.slug, type: type.slug },
    props: { group, type },
  }));
}

export interface Props { group: Group; type: CoinType }
const { group, type } = Astro.props;

const path = typePath(group.slug, type.slug);
const coins = coinsInGroupType(group.slug, type.slug);

const plural = type.namePlural.toLowerCase();
const h1 = pairH1(group, type);
const question = pairQuestion(group, type);
const answer = pairAnswer(group, type);
const description = pairDescription(group, type);
const intro = pairIntro(group, type);
const sections = pairSections(group, type);

// The price every metal figure under this page is worked at, stated once and
// big, the way the melt section states it. A reader who has landed on "silver
// quarters" is holding metal, and the number that turns a weight into a value
// is the first thing they need; the melt side has the arithmetic, this is the
// input to it. Read off the coins rather than the group slug -- a 40% silver
// clad half is clad by construction and silver by content.
const metals = metalsIn(coins);

// The melt twin, when it is built. See the note on the group archive.
const meltTwin = meltPairs().some((p) => p.group.slug === group.slug && p.type.slug === type.slug)
  ? meltTypePath(group.slug, type.slug)
  : undefined;
---
<Base
  title={pairSeoTitle(group, type)}
  description={description}
  path={path}
  crumbs={[
    { label: 'Coin values', href: '/coin-value' },
    { label: group.name, href: groupPath(group.slug) },
    { label: type.namePlural, href: path },
  ]}
  schemas={[
    webPageSchema({
      type: 'CollectionPage',
      name: h1,
      description,
      path,
    }),
    itemListSchema({
      name: h1,
      description,
      items: coins.map((c) => ({ name: c.name, path: coinPath(c) })),
    }),
    faqSchema([{ q: question, a: answer }]),
  ]}
>
  <section class="container-page pt-8 pb-10">
    <div class="prose-page">
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.85rem">{h1}</h1>
      <div class="reeded" aria-hidden="true" style={`--metal: var(--metal-${group.slug})`}></div>
      <div class="verdict" style={`--metal: var(--metal-${group.slug})`}>
        <span class="verdict-label">{question}</span>
        <p>{answer}</p>
      </div>
      {metals.map((m) => (
        <section class="figure-block not-prose" style={`--metal: var(--metal-${group.slug})`}>
          <p class="figure-label">{METAL_LABEL[m]} price these coins are worked at</p>
          <p class="figure-big" data-spot="price-unit" data-spot-metal={m}>{`${formatUsd(spotPrice(m))}/ozt`}</p>
          <p class="figure-note" data-spot="caveat" data-spot-metal={m}>{spotCaveat(m)}</p>
          {meltTwin && (
            <p class="figure-link">
              <a href={meltTwin}>{group.name} {type.name.toLowerCase()} melt value &rarr;</a>
            </p>
          )}
        </section>
      ))}
      {type.faceNote && (
        <p style="margin-top: 1.3rem"><strong>Face value.</strong> {type.faceNote}</p>
      )}
      {intro.map((p) => <p style="margin-top: 1.3rem">{p}</p>)}
    </div>
  </section>

  <section class="container-page pb-20">
    <div class="prose-page" style="margin-bottom: 1.1rem">
      <h2 style="margin-top: 0">{sections.coins.heading}</h2>
    </div>
    <div class="tile-grid">
      {coins.map((c) => <CoinTile coin={c} />)}
    </div>
    <div class="prose-page" style="margin-top: 2rem">
      <p class="text-sm" style="color: var(--text-muted)">
        Looking for a different metal? See <a href={groupPath(group.slug)}>all {group.name.toLowerCase()} coins</a>
        or <a href="/coin-value">the whole catalogue by composition</a>.
        {meltTwin && <> For the metal in these worked out and nothing else, see
          {' '}<a href={meltTwin}>{group.name.toLowerCase()} {plural} melt values</a>.</>}
      </p>
    </div>
  </section>
</Base>
