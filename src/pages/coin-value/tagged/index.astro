---
/**
 * The tag index: /coin-value/tagged.
 *
 * Exists so that the reserved `tagged` segment is a real page rather than a
 * 404 a visitor reaches by deleting the last part of a URL, which is a thing
 * people genuinely do. It is also where the two axes of the structure get
 * explained to a human in one place.
 *
 * Grouped by kind, because "series", "country" and "topic" are different
 * questions and a flat alphabetical list of thirty pills answers none of them.
 */
import Base from '../../../layouts/Base.astro';
import { itemListSchema, webPageSchema } from '../../../lib/schema';
import { populatedTags, coinsWithTag, tagPath, COINS, latestUpdated, type Tag } from '../../../data/coins';
import { COIN_VALUE_UPDATED } from '../../../lib/page-dates';

const path = '/coin-value/tagged';
const tags = populatedTags();
const updated = latestUpdated(COINS, COIN_VALUE_UPDATED);

const ORDER: { kind: Tag['kind']; title: string; blurb: string }[] = [
  {
    kind: 'series',
    title: 'By series',
    blurb:
      'A series whose composition changed partway through is split across the catalogue by metal. These pages put it back together.',
  },
  {
    kind: 'country',
    title: 'By country',
    blurb:
      'Coins are filed by what they are made of, not by where they were struck, so the country view is assembled from tags.',
  },
  {
    kind: 'composition',
    title: 'By composition detail',
    blurb: 'Finer than the top-level metal groups: a specific fineness or construction.',
  },
  { kind: 'format', title: 'By format', blurb: 'How the coin was made and sold, rather than what it is.' },
  {
    kind: 'theme',
    title: 'By topic',
    blurb: 'The categories collectors and dealers actually use in conversation.',
  },
];

const sections = ORDER.map((o) => ({ ...o, tags: tags.filter((t) => t.kind === o.kind) })).filter(
  (s) => s.tags.length > 0,
);
const DESCRIPTION =
  'Every cross-cutting view of the coin catalogue: by series, by country, by composition and by topic. Coins are filed by metal and denomination; these pages cut across that.';
---
<Base
  title="Coin Topics, Series and Countries"
  description={DESCRIPTION}
  path={path}
  crumbs={[
    { label: 'Coin values', href: '/coin-value' },
    { label: 'Topics', href: path },
  ]}
  schemas={[
    webPageSchema({
      type: 'CollectionPage',
      name: 'Coin topics, series and countries',
      description: DESCRIPTION,
      path,
      dateModified: updated,
    }),
    itemListSchema({
      name: 'Coin topics, series and countries',
      description: DESCRIPTION,
      items: tags.map((t) => ({ name: t.name, path: tagPath(t.slug) })),
    }),
  ]}
>
  <section class="container-page pt-8 pb-10">
    <div class="prose-page">
      <h1 class="text-4xl sm:text-5xl" style="margin-bottom: 0.9rem">Coin Topics, Series and Countries</h1>
      <p class="text-lg">
        <strong>
          Coins in this catalogue are filed by what they are made of and what
          denomination they are. Everything else is a tag, and every tag is a
          page.
        </strong>
      </p>
      <p>
        That split is deliberate. A coin’s metal and denomination are facts
        that will never be revised, so they are safe to put in a URL that must
        never change. A coin’s series, its country and whether it counts as
        a key date are all things we may reclassify, so they live here instead,
        where a coin can appear on as many pages as it belongs on while still
        existing at exactly one address.
      </p>
    </div>
  </section>

  {sections.map((s) => (
    <section class="container-page pb-12">
      <div class="prose-page" style="margin-bottom: 1rem">
        <h2 style="margin-top: 0">{s.title}</h2>
        <p>{s.blurb}</p>
      </div>
      <div class="tile-grid">
        {s.tags.map((t) => {
          const n = coinsWithTag(t.slug).length;
          return (
            <a href={tagPath(t.slug)} class="tile">
              <h3>{t.name}</h3>
              <p>{t.bluf}</p>
              <p class="tile-meta">{n} {n === 1 ? 'coin' : 'coins'}</p>
            </a>
          );
        })}
      </div>
    </section>
  ))}
  <div class="pb-8"></div>
</Base>
